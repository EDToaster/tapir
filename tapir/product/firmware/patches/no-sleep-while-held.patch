--- a/app/src/activity.c
+++ b/app/src/activity.c
@@ -22,4 +22,6 @@ LOG_MODULE_DECLARE(zmk, CONFIG_ZMK_LOG_LEVEL);
 
 #include <zmk/activity.h>
+#include <zmk/matrix.h>
+#include <zephyr/sys/atomic.h>
 
 #if IS_ENABLED(CONFIG_USB_DEVICE_STACK)
