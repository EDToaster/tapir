 #define MAX_SLEEP_MS CONFIG_ZMK_IDLE_SLEEP_TIMEOUT
+static ATOMIC_DEFINE(held_positions, ZMK_KEYMAP_LEN);
+
+static bool position_is_held(void) {
+    for (size_t i = 0; i < ARRAY_SIZE(held_positions); i++) {
+        if (atomic_get(&held_positions[i])) {
+            return true;
+        }
+    }
+    return false;
